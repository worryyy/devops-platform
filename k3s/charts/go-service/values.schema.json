{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "rollout": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "profile": {
          "type": "string",
          "enum": ["", "critical-canary", "standard-canary", "controlled-bluegreen", "fast-rolling"]
        },
        "strategy": {
          "type": "string",
          "enum": ["", "canary", "bluegreen", "rolling"]
        },
        "autoPromotion": {
          "type": "boolean"
        },
        "previewReplicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "scaleDownDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "promotionTimeout": {
          "type": "string",
          "pattern": "^[0-9]+(m|s)$"
        },
        "previewProbes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "path", "method"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "pattern": "^/" },
              "method": { "type": "string", "enum": ["GET"] },
              "requiresAuth": { "type": "boolean" }
            }
          }
        },
        "analysis": {
          "type": "object",
          "properties": {
            "dryRun": { "type": "boolean" },
            "interval": { "type": "string", "pattern": "^[0-9]+(m|s)$" },
            "count": { "type": "integer", "minimum": 1 },
            "consecutiveSuccessLimit": { "type": "integer", "minimum": 1 },
            "failureLimit": { "type": "integer", "minimum": 1 },
            "inconclusiveLimit": { "type": "integer", "minimum": 0 },
            "consecutiveErrorLimit": { "type": "integer", "minimum": 1 },
            "minSamples": { "type": "integer", "minimum": 1 },
            "stableMinSamples": { "type": "integer", "minimum": 1 },
            "maxErrorRate": { "type": "number", "minimum": 0, "maximum": 1 },
            "maxErrorRateIncrease": { "type": "number", "minimum": 0, "maximum": 1 },
            "maxP95Ratio": { "type": "number", "minimum": 1 },
            "maxP95Seconds": { "type": "number", "minimum": 0 },
            "minOperationSuccessRate": { "type": "number", "minimum": 0, "maximum": 1 },
            "requestRouteRegex": { "type": "string" },
            "operationRouteRegex": { "type": "string" },
            "prometheusAddress": { "type": "string" }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "strategy": { "const": "rolling" }
            }
          },
          "then": {
            "properties": {
              "enabled": { "const": false }
            }
          }
        },
        {
          "if": {
            "properties": {
              "strategy": { "enum": ["canary", "bluegreen"] }
            }
          },
          "then": {
            "properties": {
              "enabled": { "const": true }
            }
          }
        },
        {
          "if": {
            "properties": {
              "profile": { "const": "fast-rolling" }
            }
          },
          "then": {
            "properties": {
              "enabled": { "const": false },
              "strategy": { "enum": ["", "rolling"] }
            }
          }
        },
        {
          "if": {
            "properties": {
              "profile": { "enum": ["critical-canary", "standard-canary"] }
            }
          },
          "then": {
            "properties": {
              "enabled": { "const": true },
              "strategy": { "enum": ["", "canary"] }
            }
          }
        },
        {
          "if": {
            "properties": {
              "profile": { "const": "controlled-bluegreen" }
            }
          },
          "then": {
            "properties": {
              "enabled": { "const": true },
              "strategy": { "enum": ["", "bluegreen"] },
              "autoPromotion": { "const": false },
              "previewReplicaCount": { "type": "integer", "minimum": 1 }
            },
            "required": ["previewProbes"]
          }
        }
      ]
    }
  }
}
